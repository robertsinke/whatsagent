{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"skipLibCheck": true,
		"types": ["node"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	},
	"include": ["server/**/*.ts", "scripts/**/*.ts"]
}
