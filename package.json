{
  "name": "whatsagent",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/concurrent-dev.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite dev",
    "build:server": "node scripts/generate-migrations.mjs && tsc -p tsconfig.server-build.json",
    "start": "node dist/server/server/index.js",
    "build": "npm run check && vite build && npm run build:server",
    "electron:start": "electron .",
    "electron:pack": "npm run build && electron-builder --mac",
    "smoke:compiled": "node scripts/smoke-compiled-server.mjs",
    "preview": "vite preview",
    "preview:ui": "tsx scripts/ui-preview.ts",
    "postinstall": "node scripts/patch-baileys.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "refresh:provider-catalog": "tsx scripts/refresh-provider-catalog.ts",
    "check": "node scripts/patch-baileys.mjs --check && node scripts/check-migrations.mjs && node scripts/generate-migrations.mjs --check && node scripts/check-hooks.mjs && node scripts/check-no-private-data.mjs && tsx scripts/refresh-provider-catalog.ts --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.18.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vectorize-io/hindsight-client": "0.8.5",
    "baileys": "7.0.0-rc13",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1"
  }
}
