{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "whatsagent": {
      "type": "remote",
      "url": "http://127.0.0.1:9412/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:WHATSAGENT_MCP_TOKEN}"
      }
    }
  },
  "permission": {
    "*": "deny",
    "whatsagent*": "allow"
  },
  "tools": {
    "bash": false,
    "edit": false,
    "write": false,
    "read": false,
    "grep": false,
    "glob": false,
    "list": false,
    "webfetch": false,
    "websearch": false,
    "todowrite": false,
    "skill": false,
    "question": false,
    "lsp": false
  }
}
