# Example environment for local development and Docker Compose.
# Copy to `.env` (gitignored). App settings (provider, dry-run, memory) live in SQLite.

# Backend listen port (default 8787). Vite proxies /api here in development.
PORT=8787

# Optional. When unset, outbox dry-run defaults ON in every environment.
# Only the SQLite setting outbox_dry_run=false + backend restart enables live sends.
# NODE_ENV=development
#
# One-message development escape hatch for testing a self-chat draft. Ignored
# when NODE_ENV=production; leave unset during normal operation.
# WHATSAGENT_DEV_DRAFT_FROM_ME_MESSAGE_ID=

# --- Hindsight (docker compose) — only needed when settings.memory=hindsight ---
# Owner decision 2026-07-26: glm-5.2:cloud, reached through the LOCAL Ollama
# server, which proxies to Ollama Cloud using your existing auth. Provider stays
# `ollama` (not `ollama-cloud`) precisely because the local server holds the
# credential — Hindsight just talks OpenAI-compatible HTTP to localhost.
HINDSIGHT_LLM_PROVIDER=ollama
HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_LLM_MODEL=glm-5.2:cloud
