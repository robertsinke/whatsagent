# Example environment for local development and Docker Compose.
# Copy to `.env` (gitignored). App settings (provider, dry-run, memory) live in SQLite.

# Backend listen port (default 8789). Vite proxies /api here in development.
PORT=8789

# Optional. When unset, outbox dry-run defaults ON in every environment.
# Only the SQLite setting outbox_dry_run=false + backend restart enables live sends.
# NODE_ENV=development
#

# Run the app against a throwaway app-data directory instead of the platform
# default. The only safe way to start a second copy: a fresh directory pairs as
# its own device rather than putting a second Baileys socket on one account.
# `--data-dir <path>` on the command line wins over this.
# WHATSAGENT_DATA_DIR=/tmp/whatsagent-scratch

# Escape hatch: allow opening the live app-data DB from a git worktree.
# Default is refuse — a worktree backend would put a second Baileys socket on
# the owner's personal WhatsApp account. Leave unset unless you mean it.
# WHATSAGENT_ALLOW_WORKTREE_LIVE_DB=1

# UI preview only (`npm run preview:ui`): seed a split LID/phone identity pair
# without running the production merge, so both sides of an identity merge can
# be inspected. Unset (default) runs the normal convergence path.
# PREVIEW_SPLIT_IDENTITY=1

# --- Hindsight (docker compose) — only needed when settings.memory=hindsight ---
# Defaults are locally pullable Ollama models (`ollama pull gemma3:4b`). A plain
# local Ollama install works with no cloud account.
#
# Optional upgrade — Ollama Cloud via the local server's authenticated passthrough
# (provider stays `ollama`, not `ollama-cloud`, because the local server holds the
# credential). Reflect prose: glm-5.2:cloud. Retain JSON: deepseek-v4-flash:cloud
# (glm returns prose through the cloud passthrough and deadlocks the memory tick).
# Requires a Hindsight container restart to take effect — do not restart from a
# worktree.
HINDSIGHT_LLM_PROVIDER=ollama
HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_LLM_MODEL=gemma3:4b
HINDSIGHT_RETAIN_LLM_MODEL=gemma3:4b
