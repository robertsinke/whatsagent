.remember/
.DS_Store
# No trailing slash on purpose: `node_modules/` matches directories ONLY, and a
# git worktree that symlinks node_modules back to the main tree therefore shows
# it as untracked (git does not treat a symlink as a directory). Verified: with
# the slash, `git status` reports `?? node_modules` for a symlink; without it,
# clean. Both a real directory and a symlink are covered by the bare name.
node_modules
/build
/.svelte-kit
/dist
# electron-builder output (a ~250 MB .app bundle per build)
/release
*.log
.env
.env.*
!.env.example

# Local-only editor, agent, orchestration, and project-note directories.
.claude/
.slayzone/
.githooks/
docs/
.vscode/
.idea/

# Local databases and coverage output
*.db
*.sqlite*
coverage/

# Machine-specific private-data substrings for scripts/check-no-private-data.mjs
# (see scripts/private-patterns.local.example). Must stay untracked — the
# values are the disclosure the gate exists to catch.
scripts/private-patterns.local

# Stray screenshots dropped at the repo root
/*.png
